# Cline context exclusions (gitignore syntax).
# Reduces auto-context / tool reads. Explicit @-mentions can still attach a file.
# Source of truth: AGENTS.md. Spec lookup: docs/spec/INDEX.md.

# Flutter / Dart generated
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
**/build/
coverage/
*.iml

# Example host-platform scaffolding (keep example/lib and example/test)
example/android/
example/ios/
example/linux/
example/macos/
example/windows/
example/web/

# Locks / binaries / native build leftovers
pubspec.lock
**/*.png
**/*.ico
**/*.dll
**/*.pdb
**/*.exp
**/*.lib
**/*.ilk
**/*.obj
**/*.tlog
**/*.otf
**/*.ttf
**/*.jar

# Secrets and local env (never feed to models)
.env
.env.*
!.env.example

# Archived monolith docs — use docs/spec/ on demand instead
docs/archive/

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
