# Agent context exclusions (gitignore syntax).
# Keeps indexing / auto-reads off heavy or irrelevant paths.
# Source of truth: AGENTS.md. Spec lookup: docs/spec/INDEX.md.

# Flutter / Dart generated
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
**/build/
coverage/
*.iml

# Example host-platform scaffolding (keep example/lib and example/test)
example/android/
example/ios/
example/linux/
example/macos/
example/windows/
example/web/

# Secrets and local env (never feed to models)
.env
.env.*
!.env.example

# Archived monolith docs — use docs/spec/ on demand instead
docs/archive/

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
